<?xml version="1.0" encoding="utf-8"?>

<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
	  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  autoReload="true"
	  internalLogLevel="Info"
	  internalLogFile="\\s511va06\\sda\\log\\wsH2HW\\NLogSample.txt">

	﻿
	<!-- enable asp.net core layout renderers -->
	<extensions>
		<add assembly="NLog.Web.AspNetCore"/>
	</extensions>

	<!-- the targets to write to -->
	<targets>
		<target xsi:type="File" name="all_logs" fileName="\\s511va06\\sda\\log\\wsH2HW\\all.log"/>
		<target xsi:type="File" name="relevant_logs" fileName="\\s511va06\\sda\\log\\wsH2HW\\relevant.log"/>
	</targets>

	<rules>
		<logger name="*" minlevel="Debug" writeTo="all_logs" />
		<logger name="*" minlevel="Warn" writeTo="relevant_logs" />
	</rules>
</nlog>	
	